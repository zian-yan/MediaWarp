port: 9000                                  # MediaWarp 监听端口

server:                                     # 媒体服务器相关设置
  type: Emby                                # 媒体服务器类型（可选选项：Emby、Jellyfin）
  addr: http://localhost:8096               # 媒体服务器地址
  auth: 2eaxxxxxxxxxa8                      # 媒体服务器认证方式（Emby/Jellyfin 控制台 -> 高级 -> API 密钥）

log:                                        # 日志设定
  access:                                   # 访问日志设定
    console: true                           # 是否将访问日志文件输出到终端中
    file: false                             # 是否将访问日志文件记录到文件中
  service:                                  # 服务日志设定
    console: true                           # 是否将服务日志文件输出到终端中
    file: true                              # 是否将服务日志文件记录到文件中

# ttl 格式说明：
# 有效的时间单位包括 "ns"（纳秒）、"us"（或 "µs"，微秒）、"ms"（毫秒）、"s"（秒）、"m"（分钟）、"h"（小时）
# 支持的时间格式示例："300ms"、"-1.5h" 或 "2h45m" 等
# 仅当值大于 0 时生效，否则表示禁用该项缓存
# 如果你不清楚你在做什么，建议保持默认设置
cache:                                        # 缓存相关设置
  enable: true                                # 缓存总开关
  http_strm_ttl: 1m                           # HTTPStrm 重定向结果缓存有效期（仅当 http_strm.final_url 为 true 时生效）
  image_ttl: 10m                              # 图片缓存有效时间
  subtitle_ttl: 2h                            # 字幕缓存有效时间

client:                                     # 客户端过滤器
  enable: false                             # 是否启用客户端过滤器
  mode: BlackList # WhiteList / BlackList   # 黑白名单模式
  list:                                     # 名单列表（按 User-Agent 包含关系匹配）
    - Fileball
    - Infuse

http_strm:                                  # HTTPStrm 相关配置（Strm 文件内容是**标准 HTTP URL**）
  enable: true                              # 是否开启 HTTPStrm 重定向
  proxy: false                              # 是否允许流量经过媒体服务器（true: 允许串流、转码行为；false: 仅支持直接播放）
  final_url: true                           # 对 URL 进行重定向判断，找到非重定向地址再重定向给客户端，减少客户端重定向次数（适用于 Strm 内容是局域网地址但是想要在公网之中播放）
                                            # 出于 SSRF 防护，环回地址（127.0.0.0/8、::1）与链路本地地址（169.254.0.0/16）会被拒绝，局域网私网地址（192.168.x.x 等）允许
  compatibility_mode: false                 # 兼容模式，开启后将使用更兼容但效率较低的方式获取最终 URL
  hide_embedded_subtitles: false            # 对命中前缀的 Strm 条目隐藏内嵌字幕流：PlaybackInfo 里不返回这些字幕流，且直接请求字幕流时返回 404，避免媒体服务器提取字幕时把远程文件整片下载；外挂字幕（同目录 .srt/.ass/.sup）不受影响
  hide_embedded_subtitles_clients: []       # 可选：只对匹配的客户端生效（按 User-Agent 包含关系匹配，忽略大小写），留空表示对所有客户端生效
                                            # 网页播放的 UA 是浏览器 UA，要让 Web 也拦截需加入 "Mozilla"（或留空）；示例：["Polaris", "Mozilla"]
  prefix_list:                              # 媒体服务器中 Strm 文件的前缀（符合该前缀的 Strm 文件且被正确识别为 HTTP 协议都会路由到该规则下）
    - /media/strm/http
    - /media/strm/https

# 说明：本文件是唯一的配置入口，没有 Web 配置页面。
# 修改后需要重启 MediaWarp 才能生效，启动时会校验端口、服务器地址等关键项，配置错误会直接退出并打印原因。
